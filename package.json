{
  "name": "aether-desktop",
  "productName": "Aether",
  "version": "2.0.0",
  "description": "The Self-Hosted AI Operating System & Multi-Agent Desktop Companion for Windows",
  "main": "dist_electron/main.js",
  "author": "AetherMind",
  "license": "MIT",
  "scripts": {
    "build:ui": "npm --prefix ui_src run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:ui && npm run build:electron",
    "dev:ui": "npm --prefix ui_src run dev",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.aethermind.aetherdesktop",
    "productName": "Aether",
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "dist_electron/**/*",
      "desktop_ui/**/*"
    ],
    "extraResources": [
      {
        "from": "aether",
        "to": "engine/aether"
      },
      {
        "from": "desktop_app.py",
        "to": "engine/desktop_app.py"
      },
      {
        "from": "aether_cli.py",
        "to": "engine/aether_cli.py"
      },
      {
        "from": "desktop_ui",
        "to": "engine/desktop_ui"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip",
        "dir"
      ],
      "icon": "desktop_ui/logo.ico",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  }
}
